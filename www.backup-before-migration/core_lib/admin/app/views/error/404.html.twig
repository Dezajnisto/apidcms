{# twig #}
{% extends "base.html.twig" %}

{% block title %}404 - {{ lang('error.not_found') }}{% endblock %}

{% block page_title %}404 - {{ lang('error.not_found') }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto">
    <!-- Error icon -->
    <div class="text-center py-12">
        <div class="mb-8">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-red-100 rounded-full">
                <i class="fas fa-exclamation-triangle text-red-500 text-4xl"></i>
            </div>
        </div>

        <!-- Title and description -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">404</h1>
            <h2 class="text-2xl font-semibold text-red-600 mb-4">{{ lang('error.not_found') }}</h2>
            <p class="text-lg text-gray-600 mb-6">
                {{ message ?? lang('error.not_found_desc') }}
            </p>
        </div>

        <!-- Additional info -->
        <div class="mb-8 p-6 bg-gray-50 rounded-lg border">
            <div class="flex items-center justify-center space-x-4 text-sm text-gray-600">
                <div class="flex items-center space-x-2">
                    <i class="fas fa-clock"></i>
                    <span>{{ "now"|date("d.m.Y H:i") }}</span>
                </div>
                <div class="flex items-center space-x-2">
                    <i class="fas fa-user"></i>
                    <span>{{ lang('error.admin') }}</span>
                </div>
                <div class="flex items-center space-x-2">
                    <i class="fas fa-shield-alt"></i>
                    <span>{{ lang('error.authenticated') }}</span>
                </div>
            </div>
        </div>

        <!-- Quick actions -->
        <div class="mb-8">
            <h3 class="text-lg font-medium text-gray-900 mb-4">{{ lang('error.quick_actions') }}</h3>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="{{ admin_url('') }}" 
                   class="inline-flex items-center space-x-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-home"></i>
                    <span>{{ lang('error.main_panel') }}</span>
                </a>
                <a href="javascript:history.back()" 
                   class="inline-flex items-center space-x-2 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">
                    <i class="fas fa-arrow-left"></i>
                    <span>{{ lang('error.back') }}</span>
                </a>
                <button onclick="location.reload()" 
                        class="inline-flex items-center space-x-2 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">
                    <i class="fas fa-redo"></i>
                    <span>{{ lang('error.refresh') }}</span>
                </button>
            </div>
        </div>

        <!-- Useful links -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
                <h4 class="font-medium text-blue-900 mb-2">{{ lang('error.frequent_sections') }}</h4>
                <ul class="text-sm text-blue-700 space-y-1">
                    <li><a href="{{ admin_url('') }}" class="hover:underline">{{ lang('error.home_page') }}</a></li>
                    <li><a href="{{ admin_url('templates') }}" class="hover:underline">{{ lang('error.manage_templates') }}</a></li>
                    <li><a href="{{ admin_url('create-table') }}" class="hover:underline">{{ lang('error.create_table') }}</a></li>
                </ul>
            </div>
            <div class="p-4 bg-green-50 rounded-lg border border-green-200">
                <h4 class="font-medium text-green-900 mb-2">{{ lang('error.help_support') }}</h4>
                <ul class="text-sm text-green-700 space-y-1">
                    <li>{{ lang('error.help_check_url') }}</li>
                    <li>{{ lang('error.help_check_table') }}</li>
                    <li>{{ lang('error.help_check_access') }}</li>
                </ul>
            </div>
        </div>

        <!-- Technical info (for developers) -->
        <div class="p-4 bg-gray-100 rounded-lg border text-left">
            <details class="cursor-pointer">
                <summary class="font-medium text-gray-700 hover:text-gray-900">
                    <i class="fas fa-code mr-2"></i>
                    {{ lang('error.technical_info') }}
                </summary>
                <div class="mt-3 p-3 bg-white rounded border font-mono text-sm text-gray-600">
                    <div><strong>{{ lang('error.url') }}</strong> {{ app.request.uri }}</div>
                    <div><strong>{{ lang('error.time') }}</strong> {{ "now"|date("Y-m-d H:i:s") }}</div>
                    <div><strong>{{ lang('error.method') }}</strong> {{ app.request.method }}</div>
                    {% if app.request.referrer %}
                        <div><strong>{{ lang('error.referrer') }}</strong> {{ app.request.referrer }}</div>
                    {% endif %}
                </div>
            </details>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto scroll to top
    window.scrollTo(0, 0);
    
    // Hotkeys for navigation
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.history.back();
        }
        if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
            e.preventDefault();
            location.reload();
        }
        if (e.key === 'Home') {
            window.location.href = "{{ admin_url('') }}";
        }
    });

    // Loading animation
    const icon = document.querySelector('.fa-exclamation-triangle');
    if (icon) {
        icon.style.transform = 'scale(0)';
        icon.style.transition = 'transform 0.5s ease';
        
        setTimeout(() => {
            icon.style.transform = 'scale(1)';
        }, 100);
    }
});

// Search similar pages
function searchSimilarPages() {
    const currentPath = window.location.pathname;
    const searchTerm = currentPath.split('/').pop();
    
    if (searchTerm && searchTerm.length > 2) {
        console.log('Searching similar pages for:', searchTerm);
        alert('Similar page search will be available in a future update');
    }
}
</script>

<style>
/* Animation styles */
@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}

.fa-exclamation-triangle {
    animation: pulse 2s infinite;
}

/* Details/summary styles */
details > summary {
    list-style: none;
}
details > summary::-webkit-details-marker {
    display: none;
}
details[open] > summary {
    margin-bottom: 10px;
}
</style>
{% endblock %}
