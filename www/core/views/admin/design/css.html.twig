{% extends base_template %}

{% block title %}{{ lang('design.css_editor_title') }}{% endblock %}
{% block page_title %}🎨 {{ lang('design.css_editor_title') }}{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 md:p-6 border-b border-gray-200">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-gray-800 mb-1">{{ lang('design.css_global_styles') }}</h2>
                    <p class="text-sm text-gray-500">
                        {{ lang('design.css_editing_file')|replace({'{file}': css_url})|raw }}
                        <a href="/" target="_blank" class="text-blue-600 hover:text-blue-800 underline ml-1">
                            {{ lang('design.css_open_site') }}
                        </a>
                    </p>
                </div>
                <button type="button" onclick="AIAssistant.init({mode:'css',textareaId:'cm-hidden-css',editorId:'cm-css-editor',existingContent:document.getElementById('cm-hidden-css').value});AIAssistant.open()" class="inline-flex items-center space-x-2 px-4 py-2 border border-indigo-300 text-indigo-700 rounded-md hover:bg-indigo-50 transition">
                    <i class="fas fa-magic"></i><span>AI</span>
                </button>
            </div>
        </div>

        <form method="POST" action="{{ admin_url('design/css/save') }}" class="p-4 md:p-6">
            <div class="mb-4">
                <div class="text-xs text-gray-400 mb-2">{{ lang('templates.file_size') }}: {{ cssSize }}</div>
                <div id="cm-css-editor" class="w-full border border-gray-300 rounded-lg overflow-hidden" style="min-height:600px"></div>
                    <textarea name="css" id="cm-hidden-css" class="hidden">{{ css_content }}</textarea>

            {% if app.request.get('cache_cleared') %}
                <div class="mt-3 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm flex items-center space-x-2">
                    <i class="fas fa-check-circle"></i>
                    <span>{{ lang('design.css_cache_cleared') }}</span>
                </div>
            {% endif %}
            </div>

            <div class="flex items-center justify-between">
                <div>
                    <span class="text-xs text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i>
                        {{ lang('design.css_file_label') }} <code class="bg-gray-100 px-1 rounded text-xs">{{ css_url }}</code>
                    </span>
                </div>
                <button type="submit"
                        class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition flex items-center space-x-2">
                    <i class="fas fa-save"></i><span>{{ lang('design.css_save_styles') }}</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script type="module">
import { initCodeMirror } from '/assets/js/cm-editor.bundle.js?v=2';

const content = document.getElementById('cm-hidden-css').value;
const view = initCodeMirror('cm-css-editor', 'cm-hidden-css', 'css', content, 600, false);
if (view) { document.getElementById('cm-css-editor')._cmView = view; }
</script>
{% endblock %}
