{# admin/app/views/filemanager/index.html.twig — v2: таблица/сетка, per-page, пагинация #}
{% extends "base.html.twig" %}

{% block title %}{{ lang('filemanager.page_title') }}{% endblock %}

{% block page_title %}{{ lang('filemanager.page_title') }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <!-- Заголовок и кнопки -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">{{ lang('filemanager.page_title') }}</h1>
            <p class="text-sm text-gray-500 mt-1">{{ lang('filemanager.subtitle') }}</p>
        </div>
        <div class="flex items-center space-x-3">
            <button onclick="showUploadModal()" 
                    class="inline-flex items-center space-x-2 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition">
                <i class="fas fa-upload"></i>
                <span>{{ lang('filemanager.upload_btn') }}</span>
            </button>
            <button onclick="createFolder()" 
                    class="inline-flex items-center space-x-2 px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition">
                <i class="fas fa-folder-plus"></i>
                <span>{{ lang('filemanager.create_folder') }}</span>
            </button>
        </div>
    </div>

    <!-- Хлебные крошки -->
    <div class="bg-white rounded-lg shadow-sm border p-4 mb-6">
        <nav class="flex" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2">
                <li>
                    <a href="/admin/filemanager" class="text-gray-500 hover:text-gray-700">
                        <i class="fas fa-home"></i>
                    </a>
                </li>
                {% for crumb in breadcrumbs %}
                    <li class="flex items-center">
                        <span class="mx-2 text-gray-400">/</span>
                        <a href="/admin/filemanager?path={{ crumb.path|url_encode }}" 
                           class="text-gray-500 hover:text-gray-700 {{ loop.last ? 'font-medium text-gray-900' : '' }}">
                            {{ crumb.name }}
                        </a>
                    </li>
                {% endfor %}
            </ol>
        </nav>
    </div>

    <!-- Панель управления: переключатель вида + per-page + счётчик -->
    <div class="bg-white rounded-lg shadow-sm border p-4 mb-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <!-- Переключатель вида -->
            <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-500 mr-1">{{ lang('filemanager.view_label') }}</span>
                <button onclick="setViewMode('grid')" id="btn-grid" 
                        class="p-2 rounded-md border border-gray-300 text-gray-600 hover:bg-gray-100 transition"
                        title="{{ lang('filemanager.view_grid') }}">
                    <i class="fas fa-th-large"></i>
                </button>
                <button onclick="setViewMode('table')" id="btn-table"
                        class="p-2 rounded-md border border-gray-300 text-gray-600 hover:bg-gray-100 transition"
                        title="{{ lang('filemanager.view_table') }}">
                    <i class="fas fa-list"></i>
                </button>
            </div>

            <!-- Кол-во колонок в сетке -->
            <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-500">{{ lang('filemanager.cols_label') }}</span>
                <select id="colsSelect" onchange="changeCols(this.value)" 
                        class="border border-gray-300 rounded-md text-sm px-3 py-1.5 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="2" {{ cols == 2 ? 'selected' : '' }}>2</option>
                    <option value="3" {{ cols == 3 ? 'selected' : '' }}>3</option>
                    <option value="4" {{ cols == 4 ? 'selected' : '' }}>4</option>
                    <option value="6" {{ cols == 6 ? 'selected' : '' }}>6</option>
                </select>
            </div>

            <!-- Селектор кол-ва записей -->
            <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-500">{{ lang('filemanager.show_label') }}</span>
                <select id="perPageSelect" onchange="changePerPage(this.value)" 
                        class="border border-gray-300 rounded-md text-sm px-3 py-1.5 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="10" {{ pagination.per_page == 10 ? 'selected' : '' }}>10</option>
                    <option value="20" {{ pagination.per_page == 20 ? 'selected' : '' }}>20</option>
                    <option value="50" {{ pagination.per_page == 50 ? 'selected' : '' }}>50</option>
                </select>
            </div>

            <!-- Счётчик -->
            <div class="text-sm text-gray-500">
                {% if pagination.total > 0 %}
                    {{ pagination.from }}–{{ pagination.to }}{{ lang('filemanager.page_of_suffix') }}{{ pagination.total }}
                {% else %}
                    {{ lang('filemanager.no_files') }}
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Контент: сетка или таблица -->
    <div class="bg-white rounded-lg shadow-sm border">
        {% if items is empty %}
            <div class="p-12 text-center">
                <i class="fas fa-folder-open text-gray-300 text-5xl mb-4"></i>
                <h3 class="text-lg font-medium text-gray-900 mb-2">{{ lang('filemanager.folder_empty') }}</h3>
                <p class="text-gray-500 mb-4">{{ lang('filemanager.empty_hint') }}</p>
                <button onclick="showUploadModal()" 
                        class="inline-flex items-center space-x-2 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition">
                    <i class="fas fa-upload"></i>
                    <span>{{ lang('filemanager.upload_first') }}</span>
                </button>
            </div>
        {% else %}
            {# ===== Режим СЕТКИ ===== #}
            <div id="view-grid" class="hidden">
                {% set grid_class = cols == 2 ? 'grid-cols-1 sm:grid-cols-2' : (cols == 3 ? 'grid-cols-2 sm:grid-cols-3' : (cols == 4 ? 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4' : 'grid-cols-2 md:grid-cols-4 lg:grid-cols-6')) %}
                {% set thumb_size = cols == 2 ? 400 : (cols == 3 ? 320 : (cols == 4 ? 240 : 160)) %}
                {% set thumb_class = cols == 2 ? 'mx-auto w-80 h-80 object-cover rounded' : (cols == 3 ? 'mx-auto w-64 h-64 object-cover rounded' : (cols == 4 ? 'mx-auto w-48 h-48 object-cover rounded' : 'mx-auto w-32 h-32 object-cover rounded')) %}
                <div class="grid {{ grid_class }} gap-4 p-6">
                    {% for item in items %}
                        <div class="file-item group relative bg-gray-50 rounded-lg p-4 hover:bg-gray-100 transition cursor-pointer"
                             data-name="{{ item.name }}"
                             data-path="{{ item.path }}"
                             data-type="{{ item.is_dir ? 'folder' : 'file' }}">
                            
                            {% if item.is_dir %}
                                <div class="text-center">
                                    <i class="fas fa-folder text-yellow-500 text-4xl mb-2"></i>
                                    <div class="file-name text-sm font-medium text-gray-900 truncate" title="{{ item.name }}">
                                        {{ item.name }}
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1">{{ lang('filemanager.folder_badge') }}</div>
                                </div>
                            {% else %}
                                <div class="text-center">
                                    {% if item.is_image %}
                                        <div class="relative mb-2">
                                            <img src="/admin/filemanager/thumb?path={{ item.path|url_encode }}&amp;w={{ thumb_size }}&amp;h={{ thumb_size }}&amp;v={{ item.modified }}" 
                                                 alt="{{ item.name }}"
                                                 loading="lazy"
                                                 class="{{ thumb_class }}">
                                            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                                        </div>
                                    {% else %}
                                        <i class="fas fa-file text-blue-500 text-4xl mb-2"></i>
                                    {% endif %}
                                    <div class="file-name text-sm font-medium text-gray-900 truncate" title="{{ item.name }}">
                                        {{ item.name }}
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1">{{ item.size }}</div>
                                </div>
                            {% endif %}
                            
                            <!-- Контекстное меню -->
                            <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                <div class="flex space-x-1">
                                    <button onclick="event.stopPropagation(); renameItem('{{ item.path }}', '{{ item.is_dir ? 'folder' : 'file' }}', '{{ item.name }}')" 
                                            class="p-1 bg-white rounded shadow-sm hover:bg-blue-50 transition"
                                            title="{{ lang('filemanager.action_rename') }}">
                                        <i class="fas fa-edit text-xs text-blue-600"></i>
                                    </button>
                                    {% if not item.is_dir %}
                                        <button onclick="copyFileUrl('{{ item.path }}')" 
                                                class="p-1 bg-white rounded shadow-sm hover:bg-gray-50 transition"
                                                title="{{ lang('filemanager.copy_link') }}">
                                            <i class="fas fa-link text-xs text-gray-600"></i>
                                        </button>
                                    {% endif %}
                                    <button onclick="deleteItem('{{ item.path }}', '{{ item.is_dir ? 'folder' : 'file' }}')" 
                                            class="p-1 bg-white rounded shadow-sm hover:bg-red-50 transition"
                                            title="{{ lang('common.delete') }}">
                                        <i class="fas fa-trash text-xs text-red-600"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# ===== Режим ТАБЛИЦЫ ===== #}
            <div id="view-table" class="hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b">
                            <tr>
                                <th class="w-10 py-3 px-3">
                                    <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this)"
                                           class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                                           title="{{ lang('filemanager.select_all') }}">
                                </th>
                                <th class="text-left py-3 px-4 text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('filemanager.col_name') }}</th>
                                <th class="text-left py-3 px-4 text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell">{{ lang('filemanager.col_size') }}</th>
                                <th class="text-left py-3 px-4 text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">{{ lang('filemanager.col_modified') }}</th>
                                <th class="text-right py-3 px-4 text-xs font-medium text-gray-500 uppercase tracking-wider">{{ lang('filemanager.col_actions') }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {% for item in items %}
                                <tr class="file-item-table hover:bg-gray-50 transition cursor-pointer"
                                    data-name="{{ item.name }}"
                                    data-path="{{ item.path }}"
                                    data-type="{{ item.is_dir ? 'folder' : 'file' }}">
                                    
                                    <!-- checkbox -->
                                    <td class="py-3 px-3" onclick="event.stopPropagation()">
                                        <input type="checkbox" class="item-checkbox rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                                               data-path="{{ item.path }}"
                                               data-type="{{ item.is_dir ? 'folder' : 'file' }}"
                                               onchange="updateBatchBar()">
                                    </td>
                                    <!-- {{ lang('filemanager.col_name') }} -->
                                    <td class="py-3 px-4">
                                        <div class="flex items-center space-x-3">
                                            {% if item.is_dir %}
                                                <i class="fas fa-folder text-yellow-500 text-lg"></i>
                                            {% elseif item.is_image %}
                                                <img src="/admin/filemanager/thumb?path={{ item.path|url_encode }}&amp;w=64&amp;h=64&amp;v={{ item.modified }}" 
                                                     alt="" loading="lazy" class="w-8 h-8 object-cover rounded">
                                            {% else %}
                                                <i class="fas fa-file text-blue-500 text-lg"></i>
                                            {% endif %}
                                            <span class="text-sm font-medium text-gray-900 truncate max-w-[200px] sm:max-w-xs" 
                                                  title="{{ item.name }}">{{ item.name }}</span>
                                        </div>
                                    </td>
                                    
                                    <!-- {{ lang('filemanager.col_size') }} -->
                                    <td class="py-3 px-4 text-sm text-gray-500 hidden sm:table-cell">
                                        {{ item.is_dir ? '—' : item.size }}
                                    </td>
                                    
                                    <!-- {{ lang('filemanager.col_modified') }} -->
                                    <td class="py-3 px-4 text-sm text-gray-500 hidden md:table-cell">
                                        {{ item.modified_formatted }}
                                    </td>
                                    
                                    <!-- {{ lang('filemanager.col_actions') }} -->
                                    <td class="py-3 px-4 text-right">
                                        <div class="flex items-center justify-end space-x-1">
                                            <button onclick="event.stopPropagation(); renameItem('{{ item.path }}', '{{ item.is_dir ? 'folder' : 'file' }}', '{{ item.name }}')" 
                                                    class="p-1.5 rounded hover:bg-blue-50 transition"
                                                    title="{{ lang('filemanager.action_rename') }}">
                                                <i class="fas fa-edit text-sm text-blue-600"></i>
                                            </button>
                                            {% if not item.is_dir %}
                                                <button onclick="event.stopPropagation(); copyFileUrl('{{ item.path }}')" 
                                                        class="p-1.5 rounded hover:bg-gray-100 transition"
                                                        title="{{ lang('filemanager.copy_link') }}">
                                                    <i class="fas fa-link text-sm text-gray-600"></i>
                                                </button>
                                            {% endif %}
                                            <button onclick="event.stopPropagation(); deleteItem('{{ item.path }}', '{{ item.is_dir ? 'folder' : 'file' }}')" 
                                                    class="p-1.5 rounded hover:bg-red-50 transition"
                                                    title="{{ lang('common.delete') }}">
                                                <i class="fas fa-trash text-sm text-red-600"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Batch delete bar -->
            <div id="batchDeleteBar" class="hidden sticky bottom-0 bg-white border-t shadow-lg rounded-b-lg px-4 py-3 flex items-center justify-between">
                <span class="text-sm text-gray-700">
                    <span id="selectedCount">0</span> {{ lang('filemanager.selected_items') }}
                </span>
                <button onclick="batchDelete()"
                        class="inline-flex items-center space-x-2 px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition text-sm">
                    <i class="fas fa-trash"></i>
                    <span>{{ lang('common.delete') }} (<span id="batchDeleteCount">0</span>)</span>
                </button>
            </div>
        {% endif %}
    </div>

    {# ===== ПАГИНАЦИЯ ===== #}
    {% if pagination.total_pages > 1 %}
    <div class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-500">
            {{ lang('filemanager.page_of') }}{{ pagination.page }}{{ lang('filemanager.page_of_suffix') }}{{ pagination.total_pages }}
        </div>
        <nav class="flex items-center space-x-1">
            {# Первая #}
            {% if pagination.page > 1 %}
                <a href="?path={{ currentPath|url_encode }}&page=1&per_page={{ pagination.per_page }}&cols={{ cols }}" 
                   class="px-3 py-2 text-sm border border-gray-300 rounded-md text-gray-500 hover:bg-gray-50 transition"
                   title="{{ lang('filemanager.first_page') }}">
                    <i class="fas fa-angle-double-left"></i>
                </a>
                <a href="?path={{ currentPath|url_encode }}&page={{ pagination.page - 1 }}&per_page={{ pagination.per_page }}&cols={{ cols }}" 
                   class="px-3 py-2 text-sm border border-gray-300 rounded-md text-gray-500 hover:bg-gray-50 transition"
                   title="{{ lang('filemanager.prev_page') }}">
                    <i class="fas fa-angle-left"></i>
                </a>
            {% else %}
                <span class="px-3 py-2 text-sm border border-gray-200 rounded-md text-gray-300 cursor-not-allowed">
                    <i class="fas fa-angle-double-left"></i>
                </span>
                <span class="px-3 py-2 text-sm border border-gray-200 rounded-md text-gray-300 cursor-not-allowed">
                    <i class="fas fa-angle-left"></i>
                </span>
            {% endif %}

            {# Номера страниц (показываем окно вокруг текущей) #}
            {% set startPage = max(1, pagination.page - 2) %}
            {% set endPage = min(pagination.total_pages, pagination.page + 2) %}
            
            {% if startPage > 1 %}
                <span class="px-2 text-gray-400">…</span>
            {% endif %}
            
            {% for p in range(startPage, endPage) %}
                {% if p == pagination.page %}
                    <span class="px-3 py-2 text-sm bg-blue-600 text-white rounded-md font-medium">{{ p }}</span>
                {% else %}
                    <a href="?path={{ currentPath|url_encode }}&page={{ p }}&per_page={{ pagination.per_page }}&cols={{ cols }}" 
                       class="px-3 py-2 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition">
                        {{ p }}
                    </a>
                {% endif %}
            {% endfor %}
            
            {% if endPage < pagination.total_pages %}
                <span class="px-2 text-gray-400">…</span>
            {% endif %}

            {# Последняя #}
            {% if pagination.page < pagination.total_pages %}
                <a href="?path={{ currentPath|url_encode }}&page={{ pagination.page + 1 }}&per_page={{ pagination.per_page }}&cols={{ cols }}" 
                   class="px-3 py-2 text-sm border border-gray-300 rounded-md text-gray-500 hover:bg-gray-50 transition"
                   title="{{ lang('filemanager.next_page') }}">
                    <i class="fas fa-angle-right"></i>
                </a>
                <a href="?path={{ currentPath|url_encode }}&page={{ pagination.total_pages }}&per_page={{ pagination.per_page }}&cols={{ cols }}" 
                   class="px-3 py-2 text-sm border border-gray-300 rounded-md text-gray-500 hover:bg-gray-50 transition"
                   title="{{ lang('filemanager.last_page') }}">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            {% else %}
                <span class="px-3 py-2 text-sm border border-gray-200 rounded-md text-gray-300 cursor-not-allowed">
                    <i class="fas fa-angle-right"></i>
                </span>
                <span class="px-3 py-2 text-sm border border-gray-200 rounded-md text-gray-300 cursor-not-allowed">
                    <i class="fas fa-angle-double-right"></i>
                </span>
            {% endif %}
        </nav>
    </div>
    {% endif %}
</div>

<!-- Модальное окно загрузки (multi-file + drag-drop) -->
<div id="uploadModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4">
        <div class="p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ lang('filemanager.upload_file') }}</h3>

            <div id="uploadDropZone" class="upload-area rounded-lg p-8 text-center mb-4 border-2 border-dashed border-gray-300 transition">
                <i class="fas fa-cloud-upload-alt text-4xl text-gray-400 mb-3"></i>
                <p class="text-gray-600 mb-2">{{ lang('filemanager.popup_drop_hint') }}</p>
                <input type="file" id="fileInput" multiple class="hidden" accept="image/*,.pdf,.doc,.docx,.txt,.xls,.xlsx,.zip">
                <button type="button" onclick="document.getElementById('fileInput').click()"
                        class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition">
                    {{ lang('filemanager.popup_select_files') }}
                </button>
                <p class="text-sm text-gray-500 mt-2">{{ lang('filemanager.max_size_hint') }}</p>
            </div>

            <div id="uploadProgress" class="hidden mb-4">
                <div class="flex justify-between text-sm text-gray-600 mb-1">
                    <span>{{ lang('filemanager.uploading') }}</span>
                    <span id="progressPercent">0%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div id="progressBar" class="progress-bar bg-blue-600 h-2 rounded-full" style="width: 0%"></div>
                </div>
            </div>

            <div id="fileList" class="mt-3 space-y-2 hidden max-h-48 overflow-y-auto"></div>

            <div class="flex justify-end space-x-3 mt-4">
                <button type="button" onclick="hideUploadModal()"
                        class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition">
                    {{ lang('filemanager.cancel') }}
                </button>
                <button type="button" onclick="startUpload()" id="uploadButton"
                        class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition disabled:bg-gray-400 disabled:cursor-not-allowed flex items-center space-x-2"
                        disabled>
                    <i class="fas fa-upload"></i>
                    <span>{{ lang('filemanager.upload_btn') }}</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// === ИНИЦИАЛИЗАЦИЯ: режим отображения ===
(function() {
    const savedMode = localStorage.getItem('filemanager_view_mode') || 'grid';
    applyViewMode(savedMode);
})();

function setViewMode(mode) {
    localStorage.setItem('filemanager_view_mode', mode);
    applyViewMode(mode);
}

function applyViewMode(mode) {
    const gridView = document.getElementById('view-grid');
    const tableView = document.getElementById('view-table');
    const btnGrid = document.getElementById('btn-grid');
    const btnTable = document.getElementById('btn-table');
    
    if (!gridView || !tableView) return;
    
    if (mode === 'table') {
        gridView.classList.add('hidden');
        tableView.classList.remove('hidden');
        btnGrid.classList.remove('bg-blue-100', 'text-blue-700', 'border-blue-300');
        btnTable.classList.add('bg-blue-100', 'text-blue-700', 'border-blue-300');
        // Привязываем клики для таблицы
        bindTableClicks();
    } else {
        tableView.classList.add('hidden');
        gridView.classList.remove('hidden');
        btnTable.classList.remove('bg-blue-100', 'text-blue-700', 'border-blue-300');
        btnGrid.classList.add('bg-blue-100', 'text-blue-700', 'border-blue-300');
        // Привязываем клики для сетки
        bindGridClicks();
    }
}

// === НАВИГАЦИЯ: сетка ===
function bindGridClicks() {
    const fileItems = document.querySelectorAll('#view-grid .file-item');
    fileItems.forEach(item => {
        // Убираем старые обработчики через клонирование
        const clone = item.cloneNode(true);
        item.parentNode.replaceChild(clone, item);
        
        clone.addEventListener('click', function(e) {
            // Игнорируем клики по кнопкам действий
            if (e.target.closest('button') || e.target.closest('.absolute')) return;

            const path = this.dataset.path;
            const type = this.dataset.type;

            // Подсветка
            document.querySelectorAll('#view-grid .file-item').forEach(i => i.classList.remove('ring-2', 'ring-blue-500'));
            this.classList.add('ring-2', 'ring-blue-500');

            if (type === 'folder') {
                window.location.href = buildUrl({ path: path, page: 1 });
            } else {
                showFileInfo(path);
            }
        });
    });
}

// === НАВИГАЦИЯ: таблица ===
function bindTableClicks() {
    const rows = document.querySelectorAll('#view-table .file-item-table');
    rows.forEach(row => {
        // Убираем старые обработчики через клонирование
        const clone = row.cloneNode(true);
        row.parentNode.replaceChild(clone, row);

        clone.addEventListener('click', function(e) {
            if (e.target.closest('button')) return;

            const path = this.dataset.path;
            const type = this.dataset.type;

            document.querySelectorAll('#view-table .file-item-table').forEach(r => r.classList.remove('bg-blue-50'));
            this.classList.add('bg-blue-50');

            if (type === 'folder') {
                window.location.href = buildUrl({ path: path, page: 1 });
            } else {
                showFileInfo(path);
            }
        });
    });
}

// === ПАГИНАЦИЯ: смена per_page ===
function changeCols(cols) {
    localStorage.setItem('filemanager_cols', cols);
    window.location.href = buildUrl({ cols: cols });
}

function changePerPage(perPage) {
    window.location.href = buildUrl({ per_page: perPage, page: 1 });
}

// === Вспомогательная: построение URL с параметрами ===
function buildUrl(overrides) {
    const params = new URLSearchParams(window.location.search);
    const currentPath = '{{ currentPath }}';
    
    if (currentPath) params.set('path', currentPath);
    if (overrides.path !== undefined) {
        if (overrides.path) params.set('path', overrides.path);
        else params.delete('path');
    }
    if (overrides.page !== undefined) params.set('page', overrides.page);
    if (overrides.per_page !== undefined) params.set('per_page', overrides.per_page);
    if (overrides.cols !== undefined) params.set('cols', overrides.cols);
    
    return '/admin/filemanager?' + params.toString();
}

// === API запросы ===
async function apiRequest(url, options = {}) {
    try {
        const response = await fetch(url, {
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            ...options
        });
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const responseText = await response.text();
        try {
            return JSON.parse(responseText);
        } catch (jsonError) {
            console.error('JSON parse error:', jsonError);
            console.error('Response text:', responseText);
            throw new Error(__t('filemanager.error_invalid_response'));
        }
    } catch (error) {
        console.error('API request failed:', error);
        throw error;
    }
}

// === Модальное окно загрузки ===
function showUploadModal() {
    document.getElementById('uploadModal').classList.remove('hidden');
    document.getElementById('uploadModal').classList.add('flex');
}
function hideUploadModal() {
    document.getElementById('uploadModal').classList.add('hidden');
    document.getElementById('uploadModal').classList.remove('flex');
    resetUploadForm();
}

// === Мультизагрузка файлов ===
let selectedFiles = [];

function resetUploadForm() {
    document.getElementById('fileInput').value = '';
    document.getElementById('fileList').classList.add('hidden');
    document.getElementById('fileList').innerHTML = '';
    document.getElementById('uploadButton').disabled = true;
    document.getElementById('uploadProgress').classList.add('hidden');
    selectedFiles = [];
}

document.getElementById('fileInput').addEventListener('change', function(e) {
    handleFileSelection(e.target.files);
});

// Drag-and-drop
const dropZone = document.getElementById('uploadDropZone');
dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', function(e) { e.preventDefault(); dropZone.classList.remove('dragover'); });
dropZone.addEventListener('drop', function(e) {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    handleFileSelection(e.dataTransfer.files);
});

function handleFileSelection(files) {
    if (files.length === 0) return;
    selectedFiles = Array.from(files);
    const fileList = document.getElementById('fileList');
    fileList.innerHTML = '';
    selectedFiles.forEach((file, index) => {
        const fileItem = document.createElement('div');
        fileItem.className = 'flex items-center justify-between p-2 bg-gray-50 rounded';
        fileItem.innerHTML = `
            <div class="flex items-center space-x-2 min-w-0">
                <i class="fas fa-file text-gray-400 flex-shrink-0"></i>
                <span class="text-sm truncate">${file.name}</span>
                <span class="text-xs text-gray-500 flex-shrink-0">(${formatFileSize(file.size)})</span>
            </div>
            <button type="button" onclick="removeFile(${index})" class="text-red-500 hover:text-red-700 flex-shrink-0 ml-2">
                <i class="fas fa-times"></i>
            </button>`;
        fileList.appendChild(fileItem);
    });
    fileList.classList.remove('hidden');
    document.getElementById('uploadButton').disabled = false;
}

function removeFile(index) {
    selectedFiles.splice(index, 1);
    handleFileSelection(selectedFiles);
    if (selectedFiles.length === 0) document.getElementById('uploadButton').disabled = true;
}

function formatFileSize(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

async function startUpload() {
    if (selectedFiles.length === 0) return;
    const uploadProgress = document.getElementById('uploadProgress');
    const uploadButton = document.getElementById('uploadButton');
    uploadProgress.classList.remove('hidden');
    uploadButton.disabled = true;

    const currentPath = '{{ currentPath }}';
    const formData = new FormData();
    selectedFiles.forEach(file => formData.append('files[]', file));
    formData.append('path', currentPath);

    try {
        const response = await fetch('/admin/filemanager/upload-multiple', { method: 'POST', body: formData });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const result = await response.json();
        if (result.success) {
            hideUploadModal();
            showNotification(result.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            showNotification(result.message, 'error');
            resetUploadForm();
        }
    } catch (error) {
        console.error('Upload error:', error);
        showNotification(__t('filemanager.error_upload') + ': ' + error.message, 'error');
        resetUploadForm();
    }
}

// === Копирование ссылки ===
function copyFileUrl(filePath) {
    const url = '{{ storageUrl }}' + filePath;
    navigator.clipboard.writeText(url).then(() => {
        showNotification(__t('filemanager.link_copied_clipboard'), 'success');
    }).catch(() => {
        const textArea = document.createElement('textarea');
        textArea.value = url;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        showNotification(__t('filemanager.link_copied'), 'success');
    });
}

// === Удаление ===
async function deleteItem(path, type) {
    if (!confirm(__t('filemanager.confirm_delete_js').replace('{type}', type === 'folder' ? __t('filemanager.item_folder') : __t('filemanager.item_file')))) return;
    
    const clickedBtn = event && event.target ? event.target.closest('button') : null;
    let originalHtml = '';
    if (clickedBtn) {
        originalHtml = clickedBtn.innerHTML;
        clickedBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i>';
        clickedBtn.disabled = true;
    }
    
    try {
        const data = await apiRequest('/admin/filemanager/delete', {
            method: 'POST',
            body: 'path=' + encodeURIComponent(path) + '&type=' + type
        });
        if (data.success) {
            showNotification(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            showNotification(data.message, 'error');
            if (clickedBtn) { clickedBtn.innerHTML = originalHtml; clickedBtn.disabled = false; }
        }
    } catch (error) {
        console.error('Delete error:', error);
        showNotification(__t('filemanager.error_delete') + ': ' + error.message, 'error');
        if (clickedBtn) { clickedBtn.innerHTML = originalHtml; clickedBtn.disabled = false; }
    }
}

// === Создание папки ===
async function createFolder() {
    const folderName = prompt(__t('filemanager.enter_folder_name'));
    if (!folderName) return;
    if (!/^[a-zA-Z0-9_-]+$/.test(folderName)) {
        alert(__t('filemanager.folder_name_validation'));
        return;
    }
    const currentPath = '{{ currentPath }}';
    try {
        const data = await apiRequest('/admin/filemanager/create-folder', {
            method: 'POST',
            body: 'path=' + encodeURIComponent(currentPath) + '&name=' + encodeURIComponent(folderName)
        });
        if (data.success) {
            showNotification(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        console.error('Create folder error:', error);
        showNotification(__t('filemanager.error_create_folder') + ': ' + error.message, 'error');
    }
}

// === Информация о файле ===
async function showFileInfo(filePath) {
    try {
        const data = await apiRequest('/admin/filemanager/file-info?path=' + encodeURIComponent(filePath));
        if (data.success) {
            const file = data.data;
            let infoHtml = `
                <div class="mb-4">
                    <h4 class="font-semibold text-gray-900">${file.name}</h4>
                    <p class="text-sm text-gray-500">${file.path}</p>
                </div>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between"><span>{{ lang('filemanager.col_size') }}:</span><span class="font-medium">${file.size}</span></div>
                    <div class="flex justify-between"><span>{{ lang('filemanager.modified_label') }}</span><span class="font-medium">${file.modified}</span></div>
            `;
            if (file.is_image && file.dimensions) {
                infoHtml += `<div class="flex justify-between"><span>{{ lang('filemanager.col_size') }}ы:</span><span class="font-medium">${file.dimensions}</span></div>`;
            }
            infoHtml += `
                </div>
                <div class="mt-4 pt-4 border-t">
                    <button onclick="copyFileUrl('${file.path}')" 
                            class="w-full inline-flex justify-center items-center space-x-2 px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition">
                        <i class="fas fa-link"></i><span>{{ lang('filemanager.copy_link') }}</span>
                    </button>
                </div>`;
            showModal(__t('filemanager.file_info'), infoHtml);
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        console.error('File info error:', error);
        showNotification(__t('filemanager.error_load_info') + ': ' + error.message, 'error');
    }
}

// === Модальное окно ===
function showModal(title, content) {
    closeModal();
    const modalHtml = `
        <div id="infoModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4">
                <div class="p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">${title}</h3>
                    ${content}
                    <div class="mt-6 flex justify-end">
                        <button onclick="closeModal()" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition">{{ lang('filemanager.close') }}</button>
                    </div>
                </div>
            </div>
        </div>`;
    const modal = document.createElement('div');
    modal.innerHTML = modalHtml;
    document.body.appendChild(modal);
}
function closeModal() {
    const modal = document.getElementById('infoModal');
    if (modal) modal.remove();
}

// === Уведомления ===
function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    const bgColor = type === 'success' ? 'bg-green-500' : type === 'error' ? 'bg-red-500' : 'bg-blue-500';
    notification.className = `fixed top-4 right-4 ${bgColor} text-white px-6 py-3 rounded-lg shadow-lg z-50 transform transition-transform duration-300 translate-x-full`;
    notification.innerHTML = `
        <div class="flex items-center space-x-3">
            <i class="fas ${type === 'success' ? 'fa-check' : type === 'error' ? 'fa-exclamation-triangle' : 'fa-info'}"></i>
            <span>${message}</span>
        </div>`;
    document.body.appendChild(notification);
    setTimeout(() => { notification.classList.remove('translate-x-full'); }, 100);
    setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 300);
    }, 4000);
}

// === Закрытие по клику вне / ESC ===
document.addEventListener('click', function(e) {
    if (e.target.id === 'uploadModal') hideUploadModal();
    if (e.target.id === 'infoModal') closeModal();
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { hideUploadModal(); closeModal(); }
});
document.addEventListener('click', function(e) {
    if (e.target.closest('.bg-white.rounded-lg')) e.stopPropagation();
});

// === Переименование ===
async function renameItem(path, type, currentName) {
    const suggestedName = transliterate(currentName);
    const newName = prompt(__t('filemanager.rename_prompt_js').replace('{type}', type === 'folder' ? __t('filemanager.item_folder') : __t('filemanager.item_file')), suggestedName);
    if (!newName || newName === currentName) return;
    if (!/^[a-zA-Z0-9_\-\.]+$/.test(newName)) {
        alert(__t('filemanager.rename_validation'));
        return;
    }
    try {
        const data = await apiRequest('/admin/filemanager/rename', {
            method: 'POST',
            body: 'path=' + encodeURIComponent(path) + '&new_name=' + encodeURIComponent(newName) + '&type=' + type
        });
        if (data.success) {
            showNotification(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        console.error('Rename error:', error);
        showNotification(__t('filemanager.error_rename') + ': ' + error.message, 'error');
    }
}

// === Массовое выделение и удаление ===
function toggleSelectAll(checkbox) {
    document.querySelectorAll('#view-table .item-checkbox').forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateBatchBar();
}

function updateBatchBar() {
    const checked = document.querySelectorAll('#view-table .item-checkbox:checked');
    const count = checked.length;
    const bar = document.getElementById('batchDeleteBar');
    document.getElementById('selectedCount').textContent = count;
    document.getElementById('batchDeleteCount').textContent = count;
    if (count > 0) {
        bar.classList.remove('hidden');
    } else {
        bar.classList.add('hidden');
    }
    // Update select-all checkbox state
    const all = document.querySelectorAll('#view-table .item-checkbox');
    const selectAll = document.getElementById('selectAllCheckbox');
    if (selectAll) {
        selectAll.checked = all.length > 0 && count === all.length;
        selectAll.indeterminate = count > 0 && count < all.length;
    }
}

async function batchDelete() {
    const checked = document.querySelectorAll('#view-table .item-checkbox:checked');
    if (checked.length === 0) return;
    if (!confirm(__t('filemanager.confirm_delete_multiple').replace('{count}', checked.length))) return;

    const formData = new URLSearchParams();
    checked.forEach(cb => {
        formData.append('paths[]', cb.dataset.path);
        formData.append('type[]', cb.dataset.type);
    });

    const btn = document.querySelector('#batchDeleteBar button');
    const origHtml = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    btn.disabled = true;

    try {
        const response = await fetch('/admin/filemanager/delete-multiple', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        });
        const data = await response.json();
        if (data.success) {
            showNotification(data.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            showNotification(data.message, 'error');
            btn.innerHTML = origHtml;
            btn.disabled = false;
        }
    } catch (error) {
        console.error('Batch delete error:', error);
        showNotification(__t('filemanager.error_delete') + ': ' + error.message, 'error');
        btn.innerHTML = origHtml;
        btn.disabled = false;
    }
}

// Update batch bar state after table clicks are bound (view mode switch)
const origApplyViewMode = applyViewMode;
applyViewMode = function(mode) {
    origApplyViewMode(mode);
    updateBatchBar();
};

// === Транслитерация (клиент) ===
function transliterate(text) {
    const cyrillicMap = {
        'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'yo', 'ж': 'zh',
        'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n', 'о': 'o',
        'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts',
        'ч': 'ch', 'ш': 'sh', 'щ': 'shch', 'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu',
        'я': 'ya', ' ': '_'
    };
    return text.toLowerCase().split('').map(char => {
        return cyrillicMap[char] || (/[a-zA-Z0-9_\-\.]/.test(char) ? char : '_');
    }).join('').replace(/_+/g, '_').replace(/^_|_$/g, '');
}

