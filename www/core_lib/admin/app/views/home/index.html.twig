{# twig #}
{% extends "base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block page_title %}{{ title }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-lg shadow-sm border" style="padding: 50px;">
        <div class="text-center max-w-2xl mx-auto">
            <i class="fas fa-cogs text-blue-400 text-5xl mb-6"></i>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
                {{ lang('home.welcome_title') }}
            </h1>
            <p class="text-gray-600 text-lg mb-8">
                {{ lang('home.welcome_desc') }}
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                <a href="{{ admin_url('tables') }}" class="flex items-start space-x-4 p-4 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition">
                    <i class="fas fa-database text-blue-500 text-2xl mt-1"></i>
                    <div>
                        <div class="font-semibold text-gray-900">{{ lang('home.quick_tables') }}</div>
                        <div class="text-sm text-gray-500">{{ lang('home.quick_tables_desc') }}</div>
                    </div>
                </a>
                <a href="{{ admin_url('templates') }}" class="flex items-start space-x-4 p-4 rounded-lg border border-gray-200 hover:border-green-300 hover:bg-green-50 transition">
                    <i class="fas fa-file-code text-green-500 text-2xl mt-1"></i>
                    <div>
                        <div class="font-semibold text-gray-900">{{ lang('home.quick_templates') }}</div>
                        <div class="text-sm text-gray-500">{{ lang('home.quick_templates_desc') }}</div>
                    </div>
                </a>
                <a href="{{ admin_url('filemanager') }}" class="flex items-start space-x-4 p-4 rounded-lg border border-gray-200 hover:border-yellow-300 hover:bg-yellow-50 transition">
                    <i class="fas fa-folder-open text-yellow-500 text-2xl mt-1"></i>
                    <div>
                        <div class="font-semibold text-gray-900">{{ lang('home.quick_files') }}</div>
                        <div class="text-sm text-gray-500">{{ lang('home.quick_files_desc') }}</div>
                    </div>
                </a>
                <a href="{{ admin_url('forms') }}" class="flex items-start space-x-4 p-4 rounded-lg border border-gray-200 hover:border-purple-300 hover:bg-purple-50 transition">
                    <i class="fas fa-file-lines text-purple-500 text-2xl mt-1"></i>
                    <div>
                        <div class="font-semibold text-gray-900">{{ lang('home.quick_forms') }}</div>
                        <div class="text-sm text-gray-500">{{ lang('home.quick_forms_desc') }}</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
