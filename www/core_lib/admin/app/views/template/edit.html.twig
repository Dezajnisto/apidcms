{# twig #}
{% extends "base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block page_title %}{{ title }}{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto">
    <!-- Заголовок и кнопки управления -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
            <p class="text-sm text-gray-500 mt-1">{ lang('templates.file_path') }</p>
        </div>
        <div class="flex items-center space-x-3">
            {% set pageType = 'list' %}
            {% if templateName starts with 'blog' or templateName == 'list.html.twig' %}
                {% set pageType = 'blog_list' %}
            {% elseif templateName starts with 'single' or templateName ends with '_single.html.twig' %}
                {% set pageType = 'single' %}
            {% elseif templateName starts with 'page' %}
                {% set pageType = 'page' %}
            {% elseif templateName starts with 'home' or templateName starts with 'glavnaya' %}
                {% set pageType = 'home' %}
            {% elseif templateName starts with 'form' %}
                {% set pageType = 'form' %}
            {% elseif templateName == 'base.html.twig' %}
                {% set pageType = 'base' %}
            {% elseif templateName == '404.html.twig' or templateName == 'success.html.twig' %}
                {% set pageType = 'utility' %}
            {% endif %}
            <button type="button" onclick="AIAssistant.init({mode:'template',textareaId:'cm-hidden-input',pageType:'{{ pageType }}',existingContent:document.getElementById('cm-hidden-input').value});AIAssistant.open()" class="inline-flex items-center space-x-2 px-4 py-2 border border-indigo-300 text-indigo-700 rounded-md hover:bg-indigo-50 transition"><i class="fas fa-magic"></i><span>AI</span></button>
            <a href="/admin/templates" 
               class="inline-flex items-center space-x-2 px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition">
                <i class="fas fa-arrow-left"></i>
                <span>{{ lang('templates.back_to_list') }}
            </a>
        </div>
    </div>

    <!-- Сообщения об ошибках -->
    {% if error %}
        <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
            <div class="flex items-center space-x-3">
                <i class="fas fa-exclamation-circle"></i>
                <span>{{ error }}</span>
            </div>
        </div>
    {% endif %}

    <!-- Форма редактирования -->
    <div class="bg-white rounded-lg shadow-sm border">
        <div class="px-6 py-4 border-b">
            <h2 class="text-lg font-semibold text-gray-900">{{ lang('templates.editing') }} {{ templateName }}</h2>
        </div>
        
        <div class="p-6">
            <form method="post" class="space-y-6">
                <!-- Поле редактирования кода -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        { lang('templates.content_req') }
                    </label>
                    <div id="cm-editor-container" class="w-full border border-gray-300 rounded-md shadow-sm overflow-hidden" style="min-height:500px"></div>
                    <textarea name="content" id="cm-hidden-input" class="hidden">{{ content }}</textarea>
                </div>

                <!-- Подсказка по синтаксису -->
                <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-info-circle text-blue-500 mt-1"></i>
                        <div class="text-sm text-blue-700">
                            <strong class="font-medium">{ lang('templates.hint_label') }</strong>
                            <p>{ lang('templates.twig_hint') } 
                                <code class="bg-blue-100 px-1 rounded">{% verbatim %}{% extends "base.html.twig" %}{% endverbatim %}</code>
                            </p>
                            <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
                                <div><code class="bg-blue-100 px-1 rounded">{% verbatim %}{{ variable }}{% endverbatim %}</code>{ lang('templates.var_output') }</div>
                                <div><code class="bg-blue-100 px-1 rounded">{% verbatim %}{% for item in items %}{% endverbatim %}</code>{ lang('templates.cycle') }</div>
                                <div><code class="bg-blue-100 px-1 rounded">{% verbatim %}{% if condition %}{% endverbatim %}</code>{ lang('templates.condition') }</div>
                                <div><code class="bg-blue-100 px-1 rounded">{% verbatim %}{% block content %}{% endverbatim %}</code>{ lang('templates.block') }</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Статистика кода -->
                <div class="flex items-center justify-between text-sm text-gray-500">
                    <div class="flex items-center space-x-4">
                        <span id="lineCount">{{ lang('templates.line_count') }} {{ content|split('\n')|length }}</span>
                        <span id="charCount">{{ lang('templates.char_count') }} {{ content|length }}</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        
                    </div>
                </div>

                <!-- Кнопки действий -->
                <div class="flex items-center justify-end space-x-4 pt-6 border-t">
            <a href="/admin/templates" 
                       class="px-6 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition">
                        {{ lang('templates.cancel') }}
                    </a>
                    <button type="submit" 
                            class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition flex items-center space-x-2">
                        <i class="fas fa-save"></i>
                        <span>{ lang('templates.save_changes') }</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="module">
import { initCodeMirror } from '/admin/storage/js/cm-editor.bundle.js?v=2';

const content = document.getElementById('cm-hidden-input').value;
const view = initCodeMirror('cm-editor-container', 'cm-hidden-input', 'html', content, 500, false);

// Line/char stats
function updateStats() {
    if (!view) return;
    const doc = view.state.doc;
    document.getElementById('lineCount').textContent = 'Lines: ' + doc.lines;
    document.getElementById('charCount').textContent = 'Chars: ' + doc.length;
}
if (view) {
    updateStats();
    const origDispatch = view.dispatch.bind(view);
    // Poll stats on changes via update listener is already handled,
    // but we need to update them. Use a MutationObserver-like approach:
    setInterval(updateStats, 500);
}

// Ctrl+S submit
document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        document.querySelector('button[type="submit"]').click();
    }
});
</script>
{% endblock %}