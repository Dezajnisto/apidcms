# apidcms nginx configuration example
# Place in /etc/nginx/sites-available/your-site.conf

server {
    listen 80;
    server_name example.com;
    root /var/www/example.com/www;   # document root = www/
    index index.php;

    # CMS page routes that LOOK like source directories.
    #
    # The document root is www/, while core/, config/, storage/, themes/ and
    # plugins/ live one level above it — so a request for /plugins/foo can never
    # reach a real file. But the deny rule below matches by URL prefix, and a
    # site may have a page at /plugins (external page type: plugin catalog) with
    # item pages at /plugins/<slug>. Without this exception those live pages
    # answer 403 while everything else on the site works.
    #
    # Regex locations are checked in the order they appear, so the exception
    # must come first. There is no dot in the character class: a request for
    # /plugins/name/plugin.json still falls through to the deny rule.
    location ~ ^/plugins/[A-Za-z0-9_-]+/?$ {
        rewrite ^ /index.php?$query_string last;
    }

    # Security: block access to sensitive directories
    location ~ ^/(core|config|storage|themes|plugins|tmp)/ {
        deny all;
    }

    # Core assets (CSS, JS, images) — served directly
    location /assets/ {
        alias /var/www/example.com/www/assets/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # User uploads (if you want them publicly accessible)
    location /storage/uploads/ {
        # Uncomment to allow:
        # alias /var/www/example.com/storage/uploads/;
    }

    # S3 Proxy (if used)
    location /s3-proxy/ {
        try_files $uri /index.php?$query_string;
    }

    # Main router — everything else to index.php
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP processing
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;  # adjust version
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }
}
